# Default provider (recommended for easiest setup)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional alternative providers
# NIM_API_KEY=your_nvidia_nim_api_key_here
# NIM_MODEL=qwen/qwen2.5-coder-32b-instruct   # optional, defaults shown

# HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1   # required when using HuggingFace

# Local / offline testing (no API key needed)
# LLM_PROVIDER=dummy
# DUMMY_FIXED_RESPONSE={"thought":"done","action":{"tool":"finish","args":{"answer":"ok"}}}
